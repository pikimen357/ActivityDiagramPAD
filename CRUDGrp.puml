@startuml
title Activity Diagram - CRUD Proyek & Pembagian Kelompok

partition "<b>Dosen/Asisten</b>" {
  start
  :Login ke sistem;
  :Masuk menu Proyek/Kelompok;
}

' === CRUD PROYEK Horizontal ===
split
    if (Create?) then (ya)
        partition "<b>Dosen/Asisten</b>" {
            :Isi form proyek:
            - Nama Proyek
            - Deskripsi
            - Semester
            - Tahun Ajaran;
        }
        partition "<b>Sistem</b>" {
            :Validasi data;
            :Simpan ke tabel Projects;
        }
        partition "<b>Dosen/Asisten</b>" {
            :Konfirmasi proyek \nberhasil ditambahkan;
        }
    
    elseif (Read?) then (ya)
        partition "<b>Sistem</b>" {
            :Ambil daftar proyek dari tabel Projects;
        }
        partition "<b>Dosen/Asisten</b>" {
            :Tampilkan daftar proyek;
            :Lihat detail proyek;
        }
 
    
    elseif (Update?) then (ya)

        partition "<b>Dosen/Asisten</b>" {
            :Pilih proyek;
            :Edit data proyek\n (Nama, Deskripsi, Semester, Tahun Ajaran);
        }
        partition "<b>Sistem</b>" {
            :Validasi data;
            :Update tabel Projects;
        }
        partition "<b>Dosen/Asisten</b>" {
            :Konfirmasi update berhasil;
        }
    elseif (Delete?) then (ya)
        partition "<b>Dosen/Asisten</b>" {
            :Pilih proyek;
            :Konfirmasi penghapusan;
        }
        partition "<b>Sistem</b>" {
            :Cek apakah proyek\n memiliki kelompok aktif?;
            if (Ada kelompok?) then (ya)
            :Error "Proyek memiliki\n kelompok aktif";
            endif
            :Hapus proyek dari tabel Projects;
        }
        partition "<b>Dosen/Asisten</b>" {
            :Konfirmasi penghapusan berhasil;
        }
endif


' === PEMBAGIAN KELOMPOK (Vertical Flow) ===
partition "<b>Dosen/Asisten</b>" {
  :Pilih proyek untuk pembagian;
  :Klik "Buat Kelompok Baru";
  :Isi nama kelompok;
}
partition "<b>Sistem</b>" {
  :Simpan ke tabel Groups;
  :Generate group_id;
}
partition "<b>Dosen/Asisten</b>" {
  :Pilih "Tambah Anggota";
  :Pilih mahasiswa (maks 4 orang);
}
partition "<b>Sistem</b>" {
  repeat
    :Cek apakah mahasiswa sudah di kelompok lain?;
    if (Sudah?) then (ya)
      :Blur pada nama mahasiswa;
      :Kembali ke pemilihan mahasiswa;
    else (belum)
      : Pilih mahasiswa;
      :Simpan ke tabel Group_members\n (user_id, group_id, role);
    endif
  repeat while (Masih ada mahasiswa dipilih?) is (ya)
  -> tidak;
}
partition "<b>Dosen/Asisten</b>" {
  :Konfirmasi anggota berhasil ditambahkan;
  :Lihat daftar kelompok & anggota;
}

partition "<b>Dosen/Asisten</b>" {
  stop
}
@enduml
